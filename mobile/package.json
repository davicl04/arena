    "react-native-safe-area-context": "5.7.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.12",
    "@types/react": "19.2.18",
    "@types/react-test-renderer": "^19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "lightningcss": "1.30.1",
